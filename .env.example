# Copy to .env (never committed) and fill in. Read by `mygarmin` from the current directory.

# --- AI (any OpenAI-compatible API) -------------------------------------------
DEEPSEEK_API_KEY=sk-...
# Optional overrides (defaults: DeepSeek). Check the provider's current model names.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# Other providers, e.g. OpenRouter:
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat

# --- E-mail (SMTP) -------------------------------------------------------------
# Gmail: smtp.gmail.com, 587, and an app password (Google account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password
MAIL_FROM=you@gmail.com
# Comma-separated
MAIL_TO=you@gmail.com

# --- Other ---------------------------------------------------------------------
# MYGARMIN_DATA_DIR=/path/to/data
